---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  description?: string;
}
const { number, eyebrow, title, description } = Astro.props;
---

<div class="section-heading">
  <p class="eyebrow">
    <span class="section-number">{number}</span> {eyebrow}
  </p>
  <div class="section-heading-row">
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</div>
