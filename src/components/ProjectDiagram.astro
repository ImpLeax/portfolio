---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { MessagesSquare, Database, Radio, ArrowDown, ArrowRight } from '@lucide/astro';
---

<div
  class="project-diagram"
  role="img"
  aria-label={t(
    'Architecture sketch: a React client connects to a Django REST API and Django Channels for real-time chat, with PostgreSQL, PostGIS and Redis.',
  )}
>
  <div class="project-diagram-label">
    <span class="mono">{t('ARCHITECTURE SKETCH')}</span>
    <span class="diagram-dot"></span>
  </div>
  <div class="project-diagram-client">
    <MessagesSquare size={18} aria-hidden="true" />
    <span>{t('React client')}</span>
    <span class="mono">UI</span>
  </div>
  <div class="project-diagram-arrows">
    <span>
      <ArrowDown size={18} aria-hidden="true" /> HTTP / REST
    </span>
    <span>
      <ArrowDown size={18} aria-hidden="true" /> WebSocket
    </span>
  </div>
  <div class="project-diagram-services">
    <div>
      <span class="mono">{t('REQUESTS')}</span>
      <strong>Django REST API</strong>
      <span>{t('Auth · Profiles · Search')}</span>
    </div>
    <div class="realtime-service">
      <span class="mono">{t('REAL-TIME')}</span>
      <strong>Django Channels</strong>
      <span>
        <Radio size={13} aria-hidden="true" /> {t('Chat & messaging')}{' '}
      </span>
    </div>
  </div>
  <div class="project-diagram-storage">
    <Database size={17} aria-hidden="true" />
    <span>
      PostgreSQL <span class="muted">+ PostGIS</span>
    </span>
    <ArrowRight size={15} aria-hidden="true" />
    <span>Redis</span>
  </div>
  <p class="diagram-caption">{t('A REST foundation. A real-time layer.')}</p>
</div>
