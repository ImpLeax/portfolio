---
import {
  ArrowUpRight,
  ChevronDown,
  Check,
  MessagesSquare,
  BriefcaseBusiness,
  Bot,
  ScanLine,
} from '@lucide/astro';
import type { Project } from '../data/projects';
import { translator } from '../i18n';
import ProjectGallery from './ProjectGallery.astro';
import GitHubIcon from './GitHubIcon.astro';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const t = translator(Astro.currentLocale);
const icons = { messages: MessagesSquare, business: BriefcaseBusiness, bot: Bot, scan: ScanLine };
const Icon = icons[project.icon];
---

<article
  class:list={[
    'project-card',
    { 'project-featured': project.featured, 'project-wide': project.id === 'crm' },
  ]}
  aria-labelledby={`${project.id}-title`}
>
  <div class="case-study-heading">
    <span>
      <Icon size={19} aria-hidden="true" />
      {project.featured ? t('Featured case study') : t(project.category)}
    </span>
    <span class="mono">/{project.number}</span>
  </div>
  <div class="project-presentation">
    <ProjectGallery project={project} />
    <div class="project-content">
      <p class="project-category">{project.featured ? 'Spark' : t(project.category)}</p>
      <h3 id={`${project.id}-title`}>{t(project.title)}</h3>
      {project.status && <span class="project-status">{t(project.status)}</span>}
      <p class="project-description">{t(project.description)}</p>
      <ul class="project-highlights">
        {project.features.slice(0, 4).map((feature) => (
          <li>
            <Check size={15} aria-hidden="true" />
            <span>{t(feature)}</span>
          </li>
        ))}
      </ul>
      <ul class="tag-list project-tags">
        {project.technologies.slice(0, project.featured ? 8 : 6).map((value) => (
          <li>{value === 'Databases' ? t(value) : value}</li>
        ))}
      </ul>
      {project.featured && (
        <div class="project-focus">
          <span>{t(project.focus.label)}</span>
          <p>{t(project.focus.text)}</p>
        </div>
      )}
      <details class="project-details">
        <summary>
          {t('Explore project details')}
          <ChevronDown size={17} aria-hidden="true" />
        </summary>
        <div class="project-details-content">
          {!project.featured && (
            <>
              <h4>{t(project.focus.label)}</h4>
              <p>{t(project.focus.text)}</p>
            </>
          )}
          <h4>{t('Key features')}</h4>
          <ul>
            {project.features.map((feature) => (
              <li>{t(feature)}</li>
            ))}
          </ul>
          <h4>{t('Full technology stack')}</h4>
          <p>
            {project.technologies
              .map((value) => (value === 'Databases' ? t(value) : value))
              .join(' · ')}
          </p>
        </div>
      </details>
      {(project.github || project.demo) && (
        <div class="project-links">
          {project.github && (
            <a
              class="repository-link"
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t('View Repository')} — ${t(project.title)} ${t('(opens in a new tab)')}`}
            >
              <GitHubIcon size={18} />
              {t('View Repository')}
              <ArrowUpRight size={17} aria-hidden="true" />
            </a>
          )}
          {project.demo && (
            <a class="text-link" href={project.demo} target="_blank" rel="noopener noreferrer">
              {t('Live demo')}
              <ArrowUpRight size={16} aria-hidden="true" />
              <span class="sr-only">{t('(opens in a new tab)')}</span>
            </a>
          )}
        </div>
      )}
      {project.relatedRepositories?.length && (
        <div class="related-repositories">
          <p>{t('Related repositories')}</p>
          {project.relatedRepositories.map((repository) => (
            <a href={repository.url} target="_blank" rel="noopener noreferrer">
              {repository.name}
              <ArrowUpRight size={13} aria-hidden="true" />
              <span class="sr-only">{t('(opens in a new tab)')}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>
