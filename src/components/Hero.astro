---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { ArrowDown, ArrowUpRight, Database, Server, Braces, Layers } from '@lucide/astro';
import GitHubIcon from './GitHubIcon.astro';
import { profile } from '../data/profile';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-main">
    <div class="availability">
      <span class="status-dot"></span> {t('Open to junior roles & freelance projects')}
    </div>
    <p class="hero-name">
      {t('Volodymyr Bondarchuk')} <span>/</span> {t('Portfolio')}
    </p>
    <h1 id="hero-title">
      {t('Python Backend')} <br />
      <span>
        {' '}
        {t('Developer')}
        <span class="title-period">.</span>
      </span>
    </h1>
    <p class="hero-description">
      {t(
        'I build backend systems, REST APIs and the tools that connect them — from automation and bots to web scrapers.',
      )}
    </p>
    <p class="hero-position">
      {t('Junior developer. Software Engineering student. Ready to contribute.')}
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="#projects">
        {' '}
        {t('View projects')} <ArrowDown size={17} aria-hidden="true" />
      </a>
      <a class="button button-secondary" href="#contact">
        {' '}
        {t('Contact me')} <ArrowUpRight size={17} aria-hidden="true" />
      </a>
      <a
        class="hero-github icon-link"
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('GitHub (opens in a new tab)')}
      >
        <GitHubIcon size={19} />
        <span>GitHub</span>
      </a>
    </div>
  </div>
  <div
    class="hero-diagram"
    aria-label={t('Current focus: Django and REST APIs, PostgreSQL and Redis, Docker and Linux')}
  >
    <div class="diagram-topline">
      <span class="mono">{t('BACKEND / CURRENT FOCUS')}</span>
      <Braces size={17} aria-hidden="true" />
    </div>
    <p class="system-caption">{t('A connected backend, from request to data.')}</p>
    <div class="diagram-client">
      <span class="diagram-dot"></span>
      <span>{t('Web app, bot or integration')}</span>
    </div>
    <div class="diagram-connector">
      <span>REST API</span>
    </div>
    <div class="diagram-core">
      <div class="diagram-icon">
        <Server size={25} stroke-width={1.5} aria-hidden="true" />
      </div>
      <div>
        <strong>Python & Django</strong>
        <span>{t('Business logic · REST API')}</span>
      </div>
      <span class="core-marker">01</span>
    </div>
    <div class="diagram-branch" aria-hidden="true"></div>
    <div class="diagram-databases">
      <div>
        <Database size={20} stroke-width={1.5} aria-hidden="true" />
        <strong>PostgreSQL</strong>
        <span>{t('Relational data')}</span>
      </div>
      <div>
        <Layers size={20} stroke-width={1.5} aria-hidden="true" />
        <strong>Redis</strong>
        <span>{t('Caching & messaging')}</span>
      </div>
    </div>
    <div class="system-protocol">
      <span>HTTPS / JSON</span>
      <span>WebSocket</span>
      <span>ASGI</span>
    </div>
    <div class="diagram-deployment">
      <span class="mono">{t('ENVIRONMENT')}</span>
      <span>
        Docker <span class="muted">/</span> Linux
      </span>
    </div>
  </div>
  <div class="hero-bottom">
    <p>
      Python <span>·</span> Django <span>·</span> PostgreSQL <span>·</span> REST API <span>·</span>{' '}
      Docker <span>·</span> {t('Automation')}
    </p>
    <a href="#about" class="scroll-cue">
      {' '}
      {t('A little more about me')} <ArrowDown size={15} aria-hidden="true" />
    </a>
  </div>
</section>
