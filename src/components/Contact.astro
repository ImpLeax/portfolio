---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { ArrowUpRight, Send } from '@lucide/astro';
import GitHubIcon from './GitHubIcon.astro';
import { profile } from '../data/profile';
---

<section
  id="contact"
  class="contact-section container"
  tabindex="-1"
  aria-labelledby="contact-title"
>
  <div class="contact-panel">
    <div class="contact-main">
      <p class="eyebrow">
        <span class="section-number">06</span> {t('Get in touch')}
      </p>
      <h2 id="contact-title">
        {t('Let’s build')} <br /> {t('something')} <span>{t('useful.')}</span>
      </h2>
      <p>
        {t(
          'Have a Junior / Trainee backend opportunity or a project in mind? I’d like to hear about it.',
        )}
      </p>
      <a class="button button-primary" href={`mailto:${profile.email}`}>
        {' '}
        {t('Email me')} <ArrowUpRight size={18} aria-hidden="true" />
      </a>
      <a class="contact-email" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
    </div>
    <div class="contact-links">
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        <GitHubIcon />
        <span>
          <strong>GitHub</strong>
          <span>{t('Explore my code')}</span>
        </span>
        <ArrowUpRight size={18} aria-hidden="true" />
        <span class="sr-only"> {t('(opens in a new tab)')}</span>
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        <span class="linkedin-mark" aria-hidden="true">
          in
        </span>
        <span>
          <strong>LinkedIn</strong>
          <span>{t('Let’s connect professionally')}</span>
        </span>
        <ArrowUpRight size={18} aria-hidden="true" />
        <span class="sr-only"> {t('(opens in a new tab)')}</span>
      </a>
      <a href={profile.telegram} target="_blank" rel="noopener noreferrer">
        <Send size={20} aria-hidden="true" />
        <span>
          <strong>Telegram</strong>
          <span>@impleax</span>
        </span>
        <ArrowUpRight size={18} aria-hidden="true" />
        <span class="sr-only"> {t('(opens in a new tab)')}</span>
      </a>
    </div>
  </div>
</section>
