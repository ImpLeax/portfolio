---
import { GraduationCap } from '@lucide/astro';
---

<section
  id="education"
  class="section education-section container"
  tabindex="-1"
  aria-labelledby="education-title"
>
  <div>
    <p class="eyebrow">
      <span class="section-number">05</span> Education
    </p>
    <h2 id="education-title">
      A foundation
      <br />
      in engineering.
    </h2>
  </div>
  <div class="education-record">
    <div class="education-topline">
      <GraduationCap size={24} stroke-width={1.5} aria-hidden="true" />
      <span class="mono">2024 — 2028</span>
    </div>
    <h3>
      Igor Sikorsky Kyiv
      <br class="desktop-break" /> Polytechnic Institute
    </h3>
    <p>Institute of Atomic and Thermal Energy (IATE)</p>
    <div class="degree-details">
      <span>Software Engineering · Specialty 121</span>
      <span>Bachelor’s degree · Expected graduation 2028</span>
    </div>
    <span class="student-status">
      <span class="status-dot"></span>3rd-year student
    </span>
  </div>
</section>
