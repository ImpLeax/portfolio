---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { GraduationCap } from '@lucide/astro';
---

<section
  id="education"
  class="section education-section container"
  tabindex="-1"
  aria-labelledby="education-title"
>
  <div>
    <p class="eyebrow">
      <span class="section-number">05</span> {t('Education')}
    </p>
    <h2 id="education-title">{t('A foundation in engineering.')}</h2>
  </div>
  <div class="education-record">
    <div class="education-topline">
      <GraduationCap size={24} stroke-width={1.5} aria-hidden="true" />
      <span class="mono">2024 — 2028</span>
    </div>
    <h3>{t('Igor Sikorsky Kyiv Polytechnic Institute')}</h3>
    <p>{t('Institute of Atomic and Thermal Energy (IATE)')}</p>
    <div class="degree-details">
      <span>{t('Software Engineering · Specialty 121')}</span>
      <span>{t('Bachelor’s degree · Expected graduation 2028')}</span>
    </div>
    <span class="student-status">
      <span class="status-dot"></span>
      {t('3rd-year student')}{' '}
    </span>
  </div>
</section>
