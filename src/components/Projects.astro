---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { ArrowUpRight } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
import { profile } from '../data/profile';
---

<section
  id="projects"
  class="section projects-section"
  tabindex="-1"
  aria-label={t('Featured projects')}
>
  <div class="container">
    <SectionHeading
      number="02"
      eyebrow={t('Selected work')}
      title={t('From an idea to a working system.')}
      description={t(
        'Personal and university work exploring backend architecture, real-time communication and useful automation.',
      )}
    />
    <div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <div class="projects-footer">
      <p>{t('Hands-on projects. Real technical problems. Always learning.')}</p>
      <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">
        {' '}
        {t('Find me on GitHub')} <ArrowUpRight size={16} aria-hidden="true" />
        <span class="sr-only"> {t('(opens in a new tab)')}</span>
      </a>
    </div>
  </div>
</section>
