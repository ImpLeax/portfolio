---
import { translator } from '../i18n';
const t = translator(Astro.currentLocale);
import { Server, Database, Workflow, Bot, Terminal, PanelsTopLeft } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/skills';
const icons = {
  server: Server,
  database: Database,
  workflow: Workflow,
  bot: Bot,
  terminal: Terminal,
  panels: PanelsTopLeft,
};
---

<section id="skills" class="section container" tabindex="-1" aria-label={t('Technical skills')}>
  <SectionHeading
    number="03"
    eyebrow={t('The toolkit')}
    title={t('Python first. A practical stack.')}
    description={t(
      'Backend is my focus. Everything else helps me build and deliver a complete application.',
    )}
  />
  <div class="skills-grid">
    {skills.map((group) => {
      const Icon = icons[group.icon];
      return (
        <div class:list={['skill-group', { 'skill-primary': 'primary' in group }]}>
          <div class="skill-heading">
            <Icon size={21} stroke-width={1.6} aria-hidden="true" />
            <h3>{t(group.name)}</h3>
            {'primary' in group && <span class="small-label">{t('Core focus')}</span>}
          </div>
          <p class="skill-note">{t(group.note)}</p>
          <ul class="tag-list">
            {group.items.map((item) => (
              <li>{item === 'React (basic)' ? t(item) : item}</li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
  <p class="section-footnote">
    {t(
      'Frontend supports my backend work: I can build simple to medium-complexity interfaces and connect them to APIs.',
    )}
  </p>
</section>
