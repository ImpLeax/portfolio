---
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { assetPath } from '../lib/paths';
const title = 'Volodymyr Bondarchuk — Python Backend Developer';
const description =
  'Junior Python Backend Developer specializing in Django, REST APIs, PostgreSQL, automation, bots and web scraping.';
const canonical = new URL(import.meta.env.BASE_URL, Astro.site);
const socialImage = new URL(assetPath('images/social-card.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Volodymyr Bondarchuk" />
    <meta name="theme-color" content="#101214" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={assetPath('icons/favicon.svg')} />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Volodymyr Bondarchuk — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Volodymyr Bondarchuk — Python Backend Developer. Django, REST APIs, PostgreSQL and automation."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
