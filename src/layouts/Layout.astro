---
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistCyrillic from '@fontsource-variable/geist/files/geist-cyrillic-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/preferences.css';
import { assetPath } from '../lib/paths';
import { getLocale, languagePath, translator } from '../i18n';
const locale = getLocale(Astro.currentLocale);
const t = translator(locale);
const title = t('Volodymyr Bondarchuk — Python Backend Developer');
const description = t(
  'Junior Python Backend Developer specializing in Django, REST APIs, PostgreSQL, automation, bots and web scraping.',
);
const canonical = new URL(languagePath(locale), Astro.site);
const socialImage = new URL(assetPath('images/social-card.png'), Astro.site);
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={t('Volodymyr Bondarchuk')} />
    <meta name="theme-color" content="#101214" />
    <meta name="color-scheme" content="dark light" />
    <!-- Resolve preferences before styles paint. Explicit Ukrainian links keep their locale. -->
    <script
      is:inline
      define:vars={{ englishPath: languagePath('en'), ukrainianPath: languagePath('uk') }}
    >
      (() => {
        const read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const savedTheme = read('portfolio:theme');
        const theme =
          savedTheme === 'light' || savedTheme === 'dark'
            ? savedTheme
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content =
          theme === 'light' ? '#f7f8fa' : '#101214';
        const requested = new URLSearchParams(location.search).get('lang');
        const explicit = requested === 'en' || requested === 'uk' ? requested : null;
        if (explicit) {
          try {
            localStorage.setItem('portfolio:language', explicit);
          } catch {}
        }
        const saved = read('portfolio:language');
        const browser =
          (navigator.languages?.length ? navigator.languages : [navigator.language])
            .map((value) => value.toLowerCase().split('-')[0])
            .find((value) => value === 'uk' || value === 'en') || 'en';
        const current = document.documentElement.lang;
        const language =
          explicit ||
          (current === 'uk' ? 'uk' : saved === 'en' || saved === 'uk' ? saved : browser);
        if (language !== current) {
          location.replace(
            (language === 'uk' ? ukrainianPath : englishPath) + location.search + location.hash,
          );
        }
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(languagePath('en'), Astro.site)} />
    <link rel="alternate" hreflang="uk" href={new URL(languagePath('uk'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(languagePath('en'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={assetPath('icons/favicon.svg')} />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    {locale === 'uk' && (
      <link rel="preload" href={geistCyrillic} as="font" type="font/woff2" crossorigin />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'uk' ? 'en_US' : 'uk_UA'} />
    <meta property="og:site_name" content={t('Volodymyr Bondarchuk — Portfolio')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={t(
        'Volodymyr Bondarchuk — Python Backend Developer. Django, REST APIs, PostgreSQL and automation.',
      )}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      {t('Skip to content')}
    </a>
    <slot />
  </body>
</html>
